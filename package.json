{
  "name": "html-to-android",
  "version": "0.1.0",
  "description": "Convert HTML5 apps and games (.zip) into signed Android APK + AAB - free & open source",
  "main": "main.js",
  "license": "MIT",
  "author": "MSKCTG",
  "build": {
    "appId": "com.mskctg.htmltoandroid",
    "productName": "html-to-android",
    "artifactName": "${productName} Setup ${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!.git/**",
      "!template/**",
      "!build/**",
      "!dist/**",
      "!*.md"
    ],
    "extraResources": [
      {
        "from": "template",
        "to": "template"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "html-to-android",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "${productName}"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    }
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "jimp": "^1.6.1"
  }
}
